# The mobile app's build configuration (spec-mobile-app.md "Build-time
# scope"). The open-source core ships NO defaults for identity or backends;
# each app (health, a future foundation app, ...) is this core plus values
# like these — set per EAS build profile in production, in .env locally.

# App identity (baked into the binary)
APP_NAME=
APP_SLUG=
APP_SCHEME=
APP_BUNDLE_ID=

# Backends (inlined into the JS bundle; anon key is public by design)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_NAME=

# Module composition (build-time; comma-separated dirs or url#path entries,
# same format as the platform's MODULE_SOURCES). Optional allowlist narrows
# which discovered modules are included.
MOBILE_MODULE_SOURCES=
MOBILE_MODULE_ALLOWLIST=

# Optional per-app accent color override
EXPO_PUBLIC_ACCENT_COLOR=

# Adds the push entitlement to the build. Leave unset until the App Store
# provisioning profile carries the Push Notifications capability, or every
# archive fails on a missing aps-environment entitlement.
APP_ENABLE_PUSH=
