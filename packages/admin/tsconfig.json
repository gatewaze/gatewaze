{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // Embed-build-only alias (vite.embed.config.ts) for the real sonner
      // entry behind src/embed/sonnerHostBridge.tsx; type-checks as sonner.
      "gw-sonner-real": ["./node_modules/sonner"],
      "@/*": ["./src/*"],
      "@gatewaze/shared": ["../shared/src"],
      "@gatewaze/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
