{
  "name": "@gatewaze/admin-bff",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Session holder for the admin SPA in host-session mode (VITE_AUTH_MODE=host-session): keeps the Supabase session server-side and proxies Supabase, the Gatewaze API and Realtime with the real token attached.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/secure-session": "^8.4.1",
    "@supabase/supabase-js": "^2.108.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.10.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.19.15",
    "@types/ws": "^8.18.1",
    "eslint": "^9.33.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.1.0"
  }
}
