#!/usr/bin/env sh
# Blocking security gate — runs before any commit reaches the remote.
#
#   1) gitleaks secret scan over exactly the commits being pushed
#   2) shell-call audit (no raw shell-exec outside the safe-exec wrapper)
#
# Both are deterministic (no AI, no network beyond git). CI re-runs both,
# so this is defence-in-depth, not the only line. In a genuine emergency
# you can bypass with `git push --no-verify` — CI will still catch it.
#
# The per-task AI security review is a separate contract in CLAUDE.md; this
# hook is the mechanical backstop that does not depend on an agent running.

ZERO=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_oid remote_ref remote_oid; do
  # Skip branch deletions (nothing to scan).
  [ "$local_oid" = "$ZERO" ] && continue

  if [ "$remote_oid" = "$ZERO" ]; then
    # New branch on the remote: scan from the fork point off origin/HEAD
    # if we can find one, otherwise scan the whole branch history.
    if git rev-parse --verify --quiet origin/HEAD >/dev/null 2>&1; then
      base=$(git merge-base origin/HEAD "$local_oid" 2>/dev/null)
      range="${base:+$base..}$local_oid"
    else
      range="$local_oid"
    fi
  else
    range="$remote_oid..$local_oid"
  fi

  echo "── pre-push security gate: gitleaks ($range) ──"
  if ! sh scripts/security/gitleaks-scan.sh --range "$range"; then
    fail=1
  fi
done

echo "── pre-push security gate: shell-call audit ──"
if ! pnpm exec tsx scripts/audit-shell-calls.ts; then
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "✖ pre-push security gate failed — see findings above."
  echo "  Fix them, or bypass in a real emergency with: git push --no-verify"
  exit 1
fi

echo "✔ pre-push security gate passed"
