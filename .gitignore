# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
out/
# Incremental build cache. When this is committed, `tsc -b` reads it on a fresh
# clone, decides the project is already up to date, and emits no dist/. Subpath
# imports such as '@gatewaze/shared/modules' then fail with ERR_MODULE_NOT_FOUND.
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
docker/.env
docker/.env.*
!docker/.env.example

# IDE / AI tools
.vscode/
.idea/
.mcp.json
*.swp
*.swo
.DS_Store


# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/

# Docker
docker/data/

# Supabase
supabase/.temp/
supabase/.branches/

# Edge functions: ignore everything, then whitelist core functions.
# Module-installed functions are automatically excluded without needing updates.
supabase/functions/*/
!supabase/functions/main/
supabase/functions/_shared/*
!supabase/functions/_shared/
!supabase/functions/_shared/cors.ts
!supabase/functions/_shared/email.ts
!supabase/functions/_shared/integrationEvents.ts
!supabase/functions/_shared/supabase.ts
!supabase/functions/admin-add-first/
!supabase/functions/admin-nl-query/
!supabase/functions/admin-send-magic-link/
!supabase/functions/email-generate-encoded/
!supabase/functions/email-send/
!supabase/functions/email-send-reminders/
!supabase/functions/email-sendgrid-webhook/
!supabase/functions/events-speaker-submission/
!supabase/functions/health-check/
!supabase/functions/people-attributes-get/
!supabase/functions/people-classify-job-titles/
!supabase/functions/people-enrichment/
!supabase/functions/people-normalize-location/
!supabase/functions/people-profile-update/
!supabase/functions/people-signup/
!supabase/functions/people-track-attribute/
!supabase/functions/people-track-event/
!supabase/functions/people-track-subscription/
!supabase/functions/people-validate-linkedin/
!supabase/functions/platform-generate-download-token/
!supabase/functions/platform-generate-embeddings/
!supabase/functions/platform-main/
!supabase/functions/platform-setup/

# Claude Code agent memory (machine-local; the leading ** matters — a
# root-anchored pattern misses a nested packages/*/.claude/agent-memory/)
**/.claude/agent-memory/
# Module source cache (git-cloned modules)
.gatewaze-modules/

# Uploaded module packages
data/uploaded-modules/
# Auto-generated by deployEdgeFunctions — module imports change at runtime
supabase/functions/platform-main/index.ts

# Generated portal module registries (output of generate-module-registry.ts)
packages/portal/lib/modules/generated-*
.adversarial-spec-checkpoints/

# Machine-local Claude memory (not shared)
CLAUDE.local.md

.agents/

# Python bytecode. A compiled .pyc was committed under scripts/ once.
__pycache__/
*.pyc
